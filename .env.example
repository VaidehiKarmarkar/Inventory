# Database Connection String
# For local Docker / local PostgreSQL: postgresql://postgres:postgres@localhost:5432/inventory_masters
# For Hostinger Remote PostgreSQL: postgresql://db_user:db_password@db_host:5432/db_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_masters

# Database SSL configuration (Set to "true" for production remote SSL database connections)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Express Session Hashing Secret (Use a strong random string in production)
SESSION_SECRET=optima-godown-billing-secret-key-12345

# Application Port
PORT=8080

# Cookie Security Flags (Set COOKIE_SECURE=true when deployed over HTTPS)
COOKIE_SECURE=false

# Environment Mode (development or production)
NODE_ENV=development

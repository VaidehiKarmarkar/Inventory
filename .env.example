# Database Connection
# Replace with your local PostgreSQL or Supabase connection string.
# Example for local PostgreSQL: postgresql://postgres:postgres@localhost:5432/inventory_masters
# Example for Supabase Transaction Pooler: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_masters

# SSL Configuration (set to "true" for Supabase / hosted PostgreSQL)
# Auto-detected if DATABASE_URL contains "supabase", but can be overridden here
DATABASE_SSL=false

# Express Session Hashing Secret (use a secure random string in production)
SESSION_SECRET=optima-godown-billing-secret-key-12345

# Environment (set to "production" on Hostinger for secure cookies)
NODE_ENV=development

# Port configuration (matches development expectations)
PORT=8080
BASE_PATH=/

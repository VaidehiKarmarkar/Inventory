# Local SQLite Database Connection (Optional - defaults automatically to local SQLite file: file:inventory.db)
DATABASE_URL=file:inventory.db

# Express Session Hashing Secret
SESSION_SECRET=optima-godown-billing-secret-key-12345

# Application Port (default: 8080)
PORT=8080

# Cookie Security Flags (false for local offline app)
COOKIE_SECURE=false

# Environment Mode
NODE_ENV=production

auto-install-peers=false
strict-peer-dependencies=false
# Hostinger: hardlinks from the pnpm store often land without +x on native bins.
package-import-method=copy
only-built-dependencies[]=@swc/core
only-built-dependencies[]=msw
only-built-dependencies[]=unrs-resolver
# pnpm 10: mark esbuild as reviewed-skip (avoids ERR_PNPM_IGNORED_BUILDS)
ignored-built-dependencies[]=esbuild

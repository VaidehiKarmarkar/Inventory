{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "preinstall": "node -e \"if(!process.env.npm_config_user_agent?.startsWith('pnpm')){console.error('Use pnpm instead');process.exit(1)}\"",
    "postinstall": "node scripts/fix-esbuild-perms.cjs && npm run build",
    "build": "node scripts/pnpm.cjs -r --if-present run build",
    "build:docker": "pnpm exec tsc --build && pnpm --filter @workspace/api-server --filter @workspace/billing-app run build",
    "start": "node artifacts/api-server/dist/index.mjs",
    "dev": "node scripts/pnpm.cjs -r --parallel --if-present run dev",
    "electron:start": "electron .",
    "electron:build": "node scripts/pnpm.cjs run build && node scripts/pnpm.cjs exec electron-builder",
    "db:migrate": "node scripts/pnpm.cjs --filter @workspace/db run push",
    "db:seed": "node scripts/pnpm.cjs --filter @workspace/db run seed",
    "db:check": "node scripts/check-supabase.cjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "node scripts/pnpm.cjs run typecheck:libs && node scripts/pnpm.cjs -r --if-present run typecheck"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "build": {
    "appId": "com.optimagodown.inventory",
    "productName": "OptimaGodown",
    "directories": {
      "output": "dist-electron"
    },
    "asar": true,
    "asarUnpack": [
      "artifacts/api-server/dist/**/*",
      "artifacts/billing-app/dist/**/*"
    ],
    "files": [
      "electron/**/*",
      "artifacts/api-server/dist/**/*",
      "artifacts/billing-app/dist/**/*",
      "lib/db/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
